{
    "name": "costs-to-expect/api",
    "type": "project",
    "description": "The API for Costs to Expect service",
    "keywords": [
        "API",
        "REST API",
        "Laravel",
        "Laravel API",
        "Child cost",
        "Expense API",
        "Expense tracking API",
        "Budgeting API",
        "Personal finance API",
        "Financial forecasting API",
        "Game scoring API",
        "Yahtzee API",
        "Yatzy API",
        "Dice game API",
        "Open source API"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.0.1",
        "hashids/hashids": "^4.1.0",
        "laravel/framework": "^12.0",
        "laravel/helpers": "^1.2",
        "laravel/nightwatch": "^1.30",
        "laravel/sanctum": "^4.0",
        "league/commonmark": "^2.4",
        "symfony/http-client": "^6.0",
        "symfony/mailgun-mailer": "^6.0",
        "symfony/postmark-mailer": "^6.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "filp/whoops": "^2.0",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^8.1",
        "opis/json-schema": "^1.0",
        "phpunit/phpunit": "^11.0",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ],
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html build/coverage-html --coverage-text --coverage-clover build/coverage.xml"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
